<% content_for :title, "Atur Ulang Kata Sandi - Warung Jajan" %>

<h1 class="auth-card__title">Atur Ulang Kata Sandi</h1>
<p class="auth-card__subtitle">Buat kata sandi baru untuk akunmu.</p>

<%= form_with url: password_path(params[:token]), method: :put do |form| %>
  <div class="field">
    <%= form.label :password, "Kata Sandi Baru" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password",
          placeholder: "Masukkan kata sandi baru", maxlength: 72 %>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Ulangi Kata Sandi" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
          placeholder: "Ulangi kata sandi baru", maxlength: 72 %>
  </div>

  <%= form.submit "Simpan Kata Sandi", class: "btn btn-block" %>
<% end %>
